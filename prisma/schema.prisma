generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FetchStatus {
  PENDING
  SUCCESS
  FAILED
}

enum FetchResource {
  ALLIANCE_DETAIL
  PLAYER_DETAIL
  SERVER_SCAN
}

model tracked_alliance {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  wid       Int
  gid       Int
  name      String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([wid, gid], map: "tracked_alliance_wid_gid_key")
  @@index([enabled], map: "tracked_alliance_enabled_idx")
}

model tracked_player {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  wid       Int
  pid       Int
  note      String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([wid, pid], map: "tracked_player_wid_pid_key")
  @@index([enabled], map: "tracked_player_enabled_idx")
}

model fetch_runs {
  id         String        @id @default(uuid()) @db.Uuid
  resource   FetchResource
  wid        Int?
  gid        Int?
  pid        Int?
  dayInt     Int?          @map("day_int")
  page       Int?
  perPage    Int?          @map("per_page")
  status     FetchStatus   @default(PENDING)
  attempt    Int           @default(0)
  httpStatus Int?          @map("http_status")
  error      String?
  startedAt  DateTime?     @map("started_at")
  finishedAt DateTime?     @map("finished_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  raw_guild_detail raw_guild_detail[]
  raw_rank_pid     raw_rank_pid[]

  @@index([resource, wid, gid, pid, dayInt], map: "fetch_runs_resource_idx")
  @@index([status, createdAt], map: "fetch_runs_status_created_idx")
}

model raw_guild_detail {
  wid     Int
  gid     Int
  dayInt  Int      @map("day_int")

  power   BigInt?  @db.BigInt
  kil     BigInt?  @db.BigInt
  di      Int?
  owner   String?
  sname   String?
  fname   String?

  cPower  BigInt?  @db.BigInt @map("c_power")
  cKil    BigInt?  @db.BigInt @map("c_kil")
  cDi     Int?               @map("c_di")

  createdAt DateTime? @map("created_at")
  fetchRunId String?  @db.Uuid @map("fetch_run_id")
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  fetch_run fetch_runs? @relation(fields: [fetchRunId], references: [id], onDelete: SetNull)

  @@id([wid, gid, dayInt], map: "raw_guild_detail_pkey")
  @@index([wid, gid], map: "raw_guild_detail_wid_gid_idx")
  @@index([fetchRunId], map: "raw_guild_detail_fetch_run_id_idx")
}

model raw_rank_pid {
  wid    Int
  dayInt Int @map("day_int")
  pid    Int

  gid    Int?
  gnick  String?
  cid    Int?
  ccid   Int?
  lv     Int?
  nick   String?

  power    BigInt? @db.BigInt
  maxpower BigInt? @db.BigInt
  sumkill  BigInt? @db.BigInt
  score    BigInt? @db.BigInt
  die      BigInt? @db.BigInt
  caiji    BigInt? @db.BigInt
  gx       BigInt? @db.BigInt
  bz       BigInt? @db.BigInt

  cPower   BigInt? @db.BigInt @map("c_power")
  cDie     BigInt? @db.BigInt @map("c_die")
  cScore   BigInt? @db.BigInt @map("c_score")
  cSumkill BigInt? @db.BigInt @map("c_sumkill")
  cCaiji   BigInt? @db.BigInt @map("c_caiji")

  kills    Int[]
  createdAt DateTime? @map("created_at")
  fetchRunId String?  @db.Uuid @map("fetch_run_id")
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  fetch_run fetch_runs? @relation(fields: [fetchRunId], references: [id], onDelete: SetNull)

  @@id([wid, dayInt, pid], map: "raw_rank_pid_pkey")
  @@index([wid, dayInt], map: "raw_rank_pid_wid_day_idx")
  @@index([wid, gid, dayInt], map: "raw_rank_pid_wid_gid_day_idx")
  @@index([fetchRunId], map: "raw_rank_pid_fetch_run_id_idx")
}

model alliance_snapshot {
  wid     Int
  gid     Int
  dayInt  Int     @map("day_int")

  power   BigInt? @db.BigInt
  kil     BigInt? @db.BigInt
  di      Int?
  owner   String?

  cPower  BigInt? @db.BigInt @map("c_power")
  cKil    BigInt? @db.BigInt @map("c_kil")
  cDi     Int?              @map("c_di")

  createdAt DateTime? @map("created_at")

  @@id([wid, gid, dayInt], map: "alliance_snapshot_pkey")
  @@index([wid, gid], map: "alliance_snapshot_wid_gid_idx")
  @@index([wid, dayInt], map: "alliance_snapshot_wid_day_idx")
}

model ds_alliance_history {
  wid     Int
  gid     Int
  version Int      @default(1)

  // ВАЖНО: в data лучше класть bigint-значения как string,
  // чтобы API не падал на JSON.stringify(BigInt).
  // (BigInt не сериализуется стандартным JSON). :contentReference[oaicite:3]{index=3}
  data    Json
  builtAt DateTime @default(now()) @map("built_at")

  @@id([wid, gid, version], map: "dataset_alliance_history_pkey")
}

model players {
  wid       Int
  pid       Int
  nick      String?
  lv        Int?
  firstSeen DateTime @default(now()) @map("first_seen")
  lastSeen  DateTime @default(now()) @map("last_seen")

  @@id([wid, pid], map: "player_pkey")
  @@index([wid], map: "player_wid_idx")
}

model ds_player_snapshots {
  wid    Int
  pid    Int
  dayInt Int @map("day_int")

  // ДУБЛИРУЕМ membership на день (как ты сказал)
  gid    Int?
  gnick  String?
  cid    Int?
  ccid   Int?
  nick   String?
  lv     Int?

  power    BigInt? @db.BigInt
  maxpower BigInt? @db.BigInt
  sumkill  BigInt? @db.BigInt
  die      BigInt? @db.BigInt
  score    BigInt? @db.BigInt
  caiji    BigInt? @db.BigInt
  allianceTechContribution BigInt? @db.BigInt @map("gx")
  allianceHelp             BigInt? @db.BigInt @map("bz")

  createdAt DateTime? @map("created_at")

  @@id([wid, pid, dayInt], map: "player_snapshot_pkey")
  @@index([wid, dayInt], map: "player_snapshot_wid_day_idx")
  @@index([wid, gid, dayInt], map: "player_snapshot_wid_gid_day_idx")
  @@index([wid, ccid, dayInt], map: "player_snapshot_wid_ccid_day_idx")
}

model ds_city_daily_stats {
  wid    Int
  dayInt Int @map("day_int")
  ccid   Int

  playerCount   Int    @default(0) @map("player_count")
  allianceCount Int    @default(0) @map("alliance_count")
  totalPower    BigInt @default(0) @db.BigInt @map("total_power")
  totalSumkill  BigInt @default(0) @db.BigInt @map("total_sumkill")
  totalDie      BigInt @default(0) @db.BigInt @map("total_die")
  totalScore    BigInt @default(0) @db.BigInt @map("total_score")
  totalCaiji    BigInt @default(0) @db.BigInt @map("total_caiji")
  totalGx       BigInt @default(0) @db.BigInt @map("total_gx")
  totalBz       BigInt @default(0) @db.BigInt @map("total_bz")

  builtAt DateTime @default(now()) @map("built_at")

  @@id([wid, dayInt, ccid], map: "ds_city_daily_stats_pkey")
  @@index([wid, dayInt], map: "ds_city_daily_stats_wid_day_idx")
  @@index([wid, ccid, dayInt], map: "ds_city_daily_stats_wid_ccid_day_idx")
}

model player_alliance_membership {
  wid    Int
  pid    Int
  dayInt Int @map("day_int")

  gid    Int
  gnick  String?

  @@id([wid, pid, dayInt], map: "player_alliance_membership_pkey")
  @@index([wid, gid, dayInt], map: "player_alliance_membership_wid_gid_day_idx")
}
